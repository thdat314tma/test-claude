{
  "name": "library-backend",
  "version": "1.0.0",
  "description": "Backend API for library management system",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "watch": "nodemon --exec ts-node src/server.ts",
    "db:setup": "psql -U postgres -f src/database/schema.sql",
    "db:seed": "psql -U postgres -d library_db -f src/database/seeds/sample-data.sql",
    "db:reset": "npm run db:setup && npm run db:seed"
  },
  "keywords": ["library", "api", "express", "postgresql"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "pg": "^8.11.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/body-parser": "^1.19.2",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "nodemon": "^3.0.1"
  }
}
